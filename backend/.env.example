# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
DJANGO_CORS_ALLOWED_ORIGINS=

# Database (defaults to SQLite; set DB_ENGINE=django.db.backends.mysql to use MySQL)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=/app/db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# RAG / ingestion / chunking
RAG_MAX_UPLOAD_BYTES=50000000
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_DEFAULT_TOP_K=8

# RAG / embedding (LlamaIndex). Default uses a local Ollama bge-m3 model.
# Set RAG_EMBEDDING_PROVIDER=lexical to use a dependency-free hashing embedding
# (no Ollama needed) e.g. for airtight offline demos without Ollama.
RAG_OLLAMA_BASE_URL=http://127.0.0.1:11434
RAG_OLLAMA_KEEP_ALIVE=30m
RAG_EMBEDDING_MODEL=bge-m3
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_DIM=1024
RAG_INDEX_DIR=/app/rag_index

# RAG / answer generation (LLM). Default provider=ollama (local qwen3:8b).
# Use provider=openai + RAG_LLM_BASE_URL/API_KEY for a remote OpenAI-compatible
# endpoint (e.g. DeepSeek) instead.
RAG_LLM_PROVIDER=ollama
RAG_LLM_MODEL=qwen3:8b
RAG_LLM_BASE_URL=
RAG_LLM_API_KEY=
RAG_LLM_HTTP_PROXY=
