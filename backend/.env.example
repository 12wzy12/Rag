# ---- Django ----
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
DJANGO_CORS_ALLOWED_ORIGINS=

# ---- Database ----
# 默认 SQLite（零配置）；使用 MySQL 时设置：
#   DB_ENGINE=django.db.backends.mysql
#   DB_NAME=rag / DB_USER / DB_PASSWORD / DB_HOST / DB_PORT
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=/app/db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# ---- RAG / 上传与切分 ----
RAG_MAX_UPLOAD_BYTES=50000000
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_DEFAULT_TOP_K=8

# ---- RAG / Embedding ----
# 默认：本地 Ollama 的 bge-m3（多语言，中文效果好）。
# 没有 Ollama 时可用依赖无关的词典哈希向量离线演示：
#   RAG_EMBEDDING_PROVIDER=lexical
#   RAG_SIMILARITY_THRESHOLD=0.02   （lexical 分数整体偏低，需相应调低阈值）
RAG_OLLAMA_BASE_URL=http://127.0.0.1:11434
RAG_OLLAMA_KEEP_ALIVE=30m
RAG_EMBEDDING_MODEL=bge-m3
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_DIM=1024
RAG_EMBED_BATCH_SIZE=32
RAG_INDEX_DIR=/app/rag_index

# ---- RAG / 向量存储 ----
# milvus = Milvus Lite（内嵌，默认）；memory = LlamaIndex 磁盘索引（测试/降级）。
RAG_VECTOR_BACKEND=milvus
RAG_MILVUS_URI=/app/data/milvus/milvus.db
# Milvus 起不来时自动降级 memory 并继续服务（Chunk 表是唯一事实来源）。
RAG_VECTOR_FALLBACK_TO_MEMORY=1

# ---- RAG / 重排 ----
# fusion = 本地零依赖融合重排（向量分 + BM25 词法分）；api = OpenAI 兼容 /rerank（预留）。
RAG_RERANK_PROVIDER=fusion
RAG_RERANK_ALPHA=0.6
RAG_RECALL_MULTIPLIER=3
RAG_RECALL_MAX=50

# ---- RAG / 防幻觉 ----
# 最高相关度低于该阈值时拒绝回答（refused），不调用 LLM。
# bge-m3 注意：完全无关的中文 query 余弦常在 0.30~0.45，
# 默认取 0.40，请用若干无关探测问题实测校准；
# lexical 嵌入请调低到 ~0.02。
RAG_SIMILARITY_THRESHOLD=0.40

# ---- RAG / 对话 ----
RAG_CHAT_HISTORY_TURNS=4

# ---- RAG / LLM（回答生成） ----
# ollama（本地，默认）或 openai（OpenAI 兼容远程端点，如 DeepSeek）。
RAG_LLM_PROVIDER=ollama
RAG_LLM_MODEL=qwen3:8b
RAG_LLM_BASE_URL=
RAG_LLM_API_KEY=
RAG_LLM_HTTP_PROXY=
RAG_LLM_TIMEOUT=300
